Options -Indexes
DirectorySlash Off

ErrorDocument 404 /index.php
ErrorDocument 403 /index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Existing file — serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else goes to PHP router
  RewriteRule ^ /index.php [L]
</IfModule>
