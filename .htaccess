Options -Indexes
DirectorySlash Off

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Existing file — serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Try .html extension for clean URLs
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]

  # Dynamic client detail — serve the template page for any numeric ID
  RewriteRule ^(ar|en)/admin/clients/[0-9]+$ /$1/admin/clients/_.html [L]
</IfModule>
